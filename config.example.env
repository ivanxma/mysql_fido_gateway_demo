# Required: fill in DB_HOST and DB_PORT for your own MySQL server.
# No MySQL username or password is stored here; enter those in the browser.
# Copy values into your shell/environment. Do not commit real secrets.
BROWSER_ORIGIN=https://localhost
RP_ID=localhost
DB_HOST=
DB_PORT=
DB_ACCOUNT_HOST=localhost
# Explicit development exception for DB connections to the loopback interface:
ALLOW_LOOPBACK_DB_PLAINTEXT=
# For a remote DB, remove that exception and configure certificate validation:
# DB_HOST=mysql.example.com
# DB_SSL_CA=/absolute/path/to/mysql-ca.pem
# Set stable random secrets before remote use. The combined demo displays its
# administrator token; restrict access to that administrator page.
# FLASK_SECRET_KEY=...
# ADMIN_TOKEN=...
