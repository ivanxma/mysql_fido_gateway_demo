# Copy values into your shell/environment. Do not commit real secrets.
BROWSER_ORIGIN=https://localhost
RP_ID=localhost
DB_HOST=127.0.0.1
DB_PORT=5316
DB_ACCOUNT_HOST=localhost
# Explicit development exception for DB connections to the loopback interface:
ALLOW_LOOPBACK_DB_PLAINTEXT=1
# For a remote DB, remove that exception and configure certificate validation:
# DB_HOST=mysql.example.com
# DB_SSL_CA=/absolute/path/to/mysql-ca.pem
# Set stable random secrets before remote use (the demo never displays them):
# FLASK_SECRET_KEY=...
# ADMIN_TOKEN=...
