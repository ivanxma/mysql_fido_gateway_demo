# Local tutorial profile. The app reads exported environment variables.
BROWSER_ORIGIN=https://localhost
RP_ID=localhost
DB_HOST=127.0.0.1
DB_PORT=5316
ALLOW_LOOPBACK_DB_PLAINTEXT=1
# For a remote DB, configure DB_SSL_CA and unset the loopback exception.
# DB_HOST=mysql.example.com
# DB_PORT=3306
# DB_SSL_CA=/secure/mysql-ca.pem
# Export FLASK_SECRET_KEY separately before starting. Never commit real secrets.
